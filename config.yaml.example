server:
  host: "0.0.0.0"
  port: 18010
  session_ttl_hours: 24
  shutdown_timeout: 30
  ui: false                                     # enable Web UI at /ui (or use --ui flag)
  upload_dir: "/tmp/acp-uploads"                # file upload storage directory
  conversation_workdir: "/tmp/acp-conversations" # shared workspace for conversation mode
  workspace_ttl_hours: 72                       # sweep expired pipeline-*/conv-* workspaces; 0 = never

pool:
  max_processes: 20
  max_per_agent: 10
  acquire_timeout: 60                           # seconds to wait for a free slot when pool is full; 0 = fail fast

# Filesystem sandbox — three-tier trust model for agent fs access (v0.46.0).
# Each agent's `trust` field sets its level (default 0 when unset):
#   0 sandboxed    — fs path must be within an allowed root (agent working_dir
#                    + public_workdir / pipeline / upload dirs + allowed_roots)
#   1 workspace    — free fs access EXCEPT the security-sensitive blacklist
#   2 unrestricted — no restriction (startup warning; still audited)
# Client-supplied cwd overrides (/runs metadata, pipeline shared_cwd) are held
# to the same policy, so cwd=/ can't bypass level-0 bounds. All fs ops and
# denied cwds are recorded in fs_audit — query via GET /admin/fs-audit.
sandbox:
  enabled: true
  allowed_roots: []                             # extra level-0 roots beyond working_dir + shared dirs
  # Omit `blacklist` to use the built-in default (see src/sandbox.py).
  # blacklist:
  #   - "~/.aws"
  #   - "~/.ssh"
  #   - "/etc"
  #   - "**/.env"
  #   - "**/*.pem"

# SQLite data retention (v0.41.0) — pruned every 60s by the cleanup loop.
# prompt_log retention is configured separately via prompt_log.retention_days.
retention:
  pipelines_days: 7                             # pipelines + events + conversation transcripts
  chat_days: 7                                  # Web UI chat messages
  llm_usage_days: 30                            # /usage LLM token records (usage.db)

harness:
  binary: ""                                    # absolute path to harness-factory binary; empty = disabled

# Jev router (v0.47.0) — a virtual agent (default name "auto") that asks TypeSafe AI's
# Jev (System One decision model, https://docs.typesafe.ai) which local agent should
# run a task, then hands the request to that agent unchanged. Disabled by default:
# when enabled=false nothing is registered and every existing path is untouched.
# Any Jev failure / low confidence / "other" answer falls back to default_agent —
# a Jev outage can never fail a task. Only the first max_state_chars of the prompt
# leave the host. The key stays in .env; never paste it here.
# Endpoints: POST /route/preview {prompt} (dry-run), GET /route/status.
router:
  enabled: false
  agent_name: "auto"                            # virtual agent name; must not collide with a real agent
  api_key: "${TYPESAFE_API_KEY}"                # from .env (console.typesafe.ai/keys)
  model: "jev-latest"                           # pin e.g. "jev-1.13.0" once thresholds are tuned
  timeout: 10                                   # seconds per Jev call
  confidence_threshold: 0.5                     # below this -> default_agent
  default_agent: "kiro"                         # must be a configured agent
  candidates: []                                # allowlist; empty = all enabled local agents
  exclude: []                                   # denylist applied after candidates
  max_state_chars: 6000                         # prompt prefix sent to Jev

# Lambda Burst (v0.45.0) — serverless burst backend for harness-factory agents.
# Deploy infra/lambda-burst/ via CDK first, then set function_name to the
# CDK output. Disabled by default; when disabled, /lambda-pool/* returns 503
# and any agent declaring pool: "lambda" is skipped with a warning.
# See docs/lambda-burst.md.
lambda_pool:
  enabled: false
  function_name: "acp-bridge-harness-burst"     # from CDK output FunctionName
  region: "us-east-1"
  max_concurrent: 100                           # Bridge-side brake; keep <= Lambda reserved concurrency
  timeout: 300                                  # per-invocation seconds; must be <= Lambda function timeout
  default_model: "bedrock/anthropic.claude-sonnet-4-6"

# Persist every prompt actually sent to an agent (across job/pipeline/heartbeat
# paths) for post-mortem and replay. Stored in SQLite next to jobs.db.
# Records include the original template, post-render version, and the fully
# decorated string (with shared-workspace hint + suffix). Best-effort writes
# never block the agent call.
prompt_log:
  enabled: true                                 # master switch
  redact_secrets: true                          # scrub patterns from OPERATIONS.md before write
  max_size: 1048576                             # per-field cap (1 MB); longer prompts get truncated
  retention_days: 30                            # 0 = keep forever (cleanup is opt-in)

security:
  auth_token: "${ACP_BRIDGE_TOKEN}"             # or paste token string directly
  allowed_ips:
    - "127.0.0.1"
    # - "<client-ip>"
  # allowed_private_targets: []                 # SSRF guard for client-supplied URLs
                                                 # (jobs.callback_url, mesh ws_in/ws_out).
                                                 # Empty (default) blocks loopback/link-local/
                                                 # private/reserved/metadata targets. List
                                                 # specific hostnames or CIDRs here only if
                                                 # clients legitimately name a private-network
                                                 # callback target (e.g. self-hosted n8n).
                                                 # The webhook.url configured below is trusted
                                                 # config and never needs listing here.
                                                 # Cloud metadata hosts/IPs are always blocked,
                                                 # even for an allowlisted CIDR that covers them.
                                                 # Example:
                                                 #   allowed_private_targets:
                                                 #     - "n8n.internal"
                                                 #     - "10.0.4.0/24"

# litellm (optional): shared LLM proxy for agents without native Bedrock support
# If url is set, bridge checks reachability on startup;
# agents listed in required_by are disabled if unreachable.
litellm:
  url: "http://localhost:4000"
  required_by: ["codex", "qwen"]
  env:
    LITELLM_API_KEY: "${LITELLM_API_KEY}"

agents:
  kiro:
    enabled: true
    mode: "acp"
    command: "kiro-cli"
    acp_args: ["acp", "--trust-all-tools"]
    working_dir: "/tmp"
    # trust: "workspace"   # level 1 — free fs access except security blacklist. Default is level 0 (sandboxed).
    description: "Kiro CLI agent — builds and deploys infrastructure-as-code and cloud apps on AWS (Terraform, CDK, Kubernetes/Helm), spec-driven coding"
    capabilities:
      domains: ["coding", "cloud", "devops", "infrastructure-as-code", "deployment", "terminal"]
      tags: ["agentic-ide", "aws", "cli-first", "low-latency", "spec-driven"]
      tools: ["terraform", "cdk", "kubectl", "helm", "aws-cli"]
    metadata:
      author: {name: "AWS", url: "https://kiro.dev"}
      license: "Apache-2.0"
      programming_language: "TypeScript"
      natural_languages: ["en"]
      domains: ["coding", "devops", "cloud"]
      tags: ["agentic-ide", "spec-driven", "aws"]
      links:
        - {type: "source-code", url: "https://github.com/aws/kiro-cli"}
        - {type: "homepage", url: "https://kiro.dev"}
  claude:
    enabled: true
    mode: "acp"
    command: "claude-agent-acp"
    acp_args: []
    working_dir: "/tmp"
    description: "Claude Code agent — deep multi-file coding: large refactors, architecture changes, hard debugging, careful reasoning over big codebases"
    capabilities:
      domains: ["coding", "debugging", "refactoring", "architecture", "large-codebase"]
      tags: ["agentic-cli", "claude-sonnet", "expensive", "high-accuracy", "slow-response", "terminal"]
      tools: ["code_search", "multi-file-edit", "test-runner"]
    metadata:
      author: {name: "Anthropic", url: "https://anthropic.com"}
      license: "MIT"
      programming_language: "TypeScript"
      natural_languages: ["en"]
      domains: ["coding", "refactoring", "debugging"]
      tags: ["agentic-cli", "claude-sonnet", "terminal"]
      links:
        - {type: "source-code", url: "https://github.com/anthropics/claude-code"}
        - {type: "documentation", url: "https://docs.anthropic.com/en/docs/claude-code"}
  codex:
    enabled: true
    mode: "pty"
    command: "codex"
    args: ["exec", "--full-auto", "--skip-git-repo-check"]
    working_dir: "/tmp"
    idle_timeout: 300      # kill if no stdout for this many seconds
    max_duration: 600      # hard cap on total wall-clock runtime (seconds)
    description: "OpenAI Codex CLI agent — code review, pull-request feedback, CI/automation scripts, GitHub workflow tasks"
    capabilities:
      domains: ["code-review", "pull-requests", "ci-cd", "automation", "coding"]
      tags: ["agentic-cli", "open-source", "terminal", "pr-review"]
      tools: ["git", "gh", "diff-review"]
    metadata:
      author: {name: "OpenAI", url: "https://openai.com"}
      license: "Apache-2.0"
      programming_language: "Rust"
      natural_languages: ["en"]
      domains: ["coding", "automation", "code-review"]
      tags: ["agentic-cli", "open-source", "terminal"]
      links:
        - {type: "source-code", url: "https://github.com/openai/codex"}
  qwen:
    enabled: true
    mode: "acp"
    command: "qwen"
    acp_args: ["--acp"]
    working_dir: "/tmp"
    description: "Qwen Code agent (Qwen3-Coder via Bedrock) — fast, low-cost coding: small bug fixes and patches in existing files, boilerplate, unit tests, scripts"
    capabilities:
      domains: ["bug-fix", "code-generation", "unit-tests", "boilerplate", "scripting", "coding"]
      tags: ["agentic-cli", "fast", "low-cost", "open-source", "qwen3-coder"]
      tools: ["pytest", "code-generation", "patch"]
    metadata:
      author: {name: "Alibaba Qwen Team", url: "https://qwenlm.github.io"}
      license: "Apache-2.0"
      programming_language: "TypeScript"
      natural_languages: ["en", "zh"]
      domains: ["coding", "debugging", "code-generation"]
      tags: ["agentic-cli", "open-source", "qwen3-coder"]
      links:
        - {type: "source-code", url: "https://github.com/QwenLM/qwen-code"}
        - {type: "documentation", url: "https://qwenlm.github.io/qwen-code-docs"}
  opencode:
    enabled: true
    mode: "acp"
    command: "opencode"
    acp_args: ["acp"]
    working_dir: "/tmp"
    description: "OpenCode agent (open source) — terminal-centric coding and repo chores: git operations, build/lint fixes, dependency upgrades, running and fixing CI locally, provider-agnostic model backend"
    capabilities:
      domains: ["repo-maintenance", "build-tooling", "dependency-upgrades", "terminal", "coding"]
      tags: ["agentic-cli", "open-source", "provider-agnostic", "open-weight-models"]
      tools: ["git", "npm", "make", "linters"]
    metadata:
      author: {name: "OpenCode AI", url: "https://opencode.ai"}
      license: "MIT"
      programming_language: "Go"
      natural_languages: ["en"]
      domains: ["coding", "multi-provider", "terminal"]
      tags: ["agentic-cli", "open-source", "provider-agnostic"]
      links:
        - {type: "source-code", url: "https://github.com/opencode-ai/opencode"}
        - {type: "homepage", url: "https://opencode.ai"}
  hermes:
    enabled: true
    mode: "acp"
    command: "hermes"
    acp_args: ["acp"]
    working_dir: "/tmp"
    description: "Hermes Agent (Nous Research) — personal assistant with memory and skills: research, summaries, scheduled reminders, messaging (Telegram/Discord/webhook) delivery"
    capabilities:
      domains: ["personal-assistant", "research", "messaging", "scheduling", "summarization"]
      tags: ["agentic-cli", "open-source", "provider-agnostic", "memory", "skills"]
      tools: ["web-search", "messaging", "cron"]
    metadata:
      author: {name: "Nous Research", url: "https://nousresearch.com"}
      license: "MIT"
      programming_language: "Python"
      natural_languages: ["en", "zh"]
      domains: ["coding", "multi-provider", "messaging"]
      tags: ["agentic-cli", "open-source", "provider-agnostic"]
      links:
        - {type: "source-code", url: "https://github.com/NousResearch/hermes-agent"}
        - {type: "homepage", url: "https://hermesagent.org.cn"}

  # AWS DevOps Agent — optional, disabled by default.
  # Install the reviewed AWS sample in an isolated virtual environment first;
  # replace both absolute paths below. The safe launcher requires a fixed user
  # and AgentSpace, blocks implicit AgentSpace creation, and only starts a deep
  # investigation for an explicit `/investigate ...` prompt by default.
  aws-devops:
    enabled: false
    mode: "acp"
    command: "/opt/aws-devops-agent/.venv/bin/python"
    acp_args: ["/opt/acp-bridge/src/adapters/aws_devops_launcher.py"]
    working_dir: "/tmp/aws-devops-agent"
    idle_ttl: 3600
    description: "AWS DevOps Agent — investigates and troubleshoots *existing* AWS resources: incident root cause, CloudWatch alarms/logs/metrics, service errors, cost anomalies. Read-first operations, not code writing"
    capabilities:
      domains: ["aws-operations", "incident-response", "root-cause-analysis", "observability", "sre"]
      tags: ["aws-native", "investigation", "read-mostly", "production-troubleshooting"]
      tools: ["cloudwatch-logs", "cloudwatch-metrics", "cloudtrail", "x-ray", "cost-explorer", "aws-health"]
    env:
      DEVOPS_AGENT_USER_ID: "${DEVOPS_AGENT_USER_ID}"
      DEVOPS_AGENT_REGION: "${DEVOPS_AGENT_REGION}"
      DEVOPS_AGENT_SPACE_ID: "${DEVOPS_AGENT_SPACE_ID}"
      DEVOPS_AGENT_AUTO_CREATE_SPACE: "false"
      ACP_BRIDGE_AWS_INVESTIGATION_MODE: "explicit"
      ACP_BRIDGE_AWS_REQUIRE_SPACE_ID: "true"
      ACP_BRIDGE_AWS_ALLOW_SPACE_CREATE: "false"
    metadata:
      author: {name: "AWS", url: "https://aws.amazon.com"}
      license: "MIT-0"
      programming_language: "Python"
      natural_languages: ["en"]
      domains: ["devops", "cloud", "incident-response", "cost"]
      tags: ["aws", "operations", "acp"]
      links:
        - {type: "source-code", url: "https://github.com/aws-samples/sample-aws-devops-agent-acp-mcp"}

# webhook (optional): async job completion callback
# format: "openclaw" (default) or "generic" (plain JSON POST to any URL)
#
# OpenClaw example:
# webhook:
#   url: "http://<openclaw-ip>:18789/tools/invoke"
#   token: "${OPENCLAW_TOKEN}"
#   format: "openclaw"
#   account_id: "default"
#   target: "channel:<discord-channel-id>"
#
# Hermes Agent example (HMAC-SHA256 signed):
# webhook:
#   url: "http://<hermes-ip>:8644/webhooks/acp-result"
#   secret: "${HERMES_WEBHOOK_SECRET}"
#   format: "generic"
#   account_id: "default"
#   target: "channel:<discord-channel-id>"

  # harness-factory agents — same binary, different profiles
  # Requires: harness-factory binary (https://github.com/xiwan/harness-factory)
  # pr-reviewer:
  #   enabled: true
  #   mode: "acp"
  #   command: "/usr/local/bin/harness-factory"
  #   acp_args: []
  #   working_dir: "/tmp"
  #   description: "Code review agent (harness-factory)"
  #   profile:
  #     tools:
  #       fs: { permissions: [read, list] }
  #       git: { permissions: [diff, log, show] }
  #       shell: { allowlist: [pytest, mypy, grep] }
  #     orchestration: free
  #     resources:
  #       timeout: 300s
  #       max_turns: 20
  #     agent:
  #       model: "bedrock/anthropic.claude-sonnet-4-6"
  #       system_prompt: "You are a code reviewer. Analyze diffs and produce review reports."
  #       temperature: 0.3

  # Lambda Burst agent (v0.45.0) — same harness-factory profile shape, but each
  # call runs as an AWS Lambda invocation instead of a local subprocess.
  # Requires lambda_pool.enabled: true above. No `command`/`acp_args` needed —
  # the binary lives in the Lambda layer, not on this host.
  # Stateless: every /runs call is an independent invocation with no session
  # reuse, so this suits fan-out bursts rather than multi-turn conversations.
  # burst-worker:
  #   enabled: true
  #   pool: "lambda"                  # "local" (default) | "lambda"
  #   description: "Burst worker (harness-factory on Lambda)"
  #   model: "bedrock/anthropic.claude-sonnet-4-6"   # defaults to lambda_pool.default_model
  #   profile:
  #     tools:
  #       fs: { permissions: [read, list, write] }
  #       shell: { allowlist: [python3, pytest] }
  #     resources:
  #       timeout: 300s
  #       max_turns: 20
  #   metadata:
  #     domains: ["coding"]
  #     tags: ["burst", "serverless"]

# --- A2A Mesh (optional, decentralized discovery — L0) ---
# When omitted or enabled:false, the Bridge behaves exactly as today (no mesh
# endpoints, no announce). Enable to join a decentralized mesh of Bridges where
# any node can discover every other node's agents.
# mesh:
#   enabled: true
#   node_id: "node-a"                 # defaults to host:port
#   mode: "dual"                      # private | public | dual (default: public)
#   private_url: "http://10.0.2.100:18010"  # internal/VPC address (for private/dual)
#   public_url: "http://34.213.151.41:18010" # external address (for public/dual)
#   self_url: "http://10.0.2.100:18010"  # backward-compat fallback (used if mode not set)
#   announce_interval: 300            # seconds; doubles as heartbeat
#   max_hops: 1                       # reserved gossip depth field
#   token: "${MESH_TOKEN}"            # shared secret for /a2a/announce auth — REQUIRED
                                       # when mesh.enabled is true: /a2a and /a2a/announce
                                       # get no auth from the global Bearer middleware, so
                                       # an empty token here refuses to start (fail-closed).
#   seeds:                            # initial peers to announce to on startup
#     - "http://10.0.3.50:18010"
#   pricing:                          # this node's declared pricing (L0: free only)
#     model: "free"                   # free | per_token | per_call (future)
#     rate: 0
